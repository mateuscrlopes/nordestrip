# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# MapTiler browser key. Restrict it by allowed HTTP origins in MapTiler.
NEXT_PUBLIC_MAPTILER_KEY=

# Server-only routing key. Never expose it to browser code.
OPENROUTESERVICE_API_KEY=

# Server-only Pluggy application credentials.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
