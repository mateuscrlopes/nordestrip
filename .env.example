NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google Maps browser key; restrict by HTTP referrer in Google Cloud.
# Do not mark the browser key as a secret in hosting, because it is bundled client-side.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
SECRETS_SCAN_OMIT_KEYS=NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
